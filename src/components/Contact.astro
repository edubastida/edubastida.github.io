---
import personalData from '../data/personal.json';
---

<section
  id="contact"
  class="compact-section"
  style="background: var(--bg-section); position: relative; z-index: 5; scroll-margin-top: 80px;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-9 reveal">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Let's talk.</h2>
        <p class="contact-intro">
          Feel free to contact me by email or find me on LinkedIn and GitHub.
        </p>
      </div>

      <div class="contact-links reveal" style="transition-delay: 0.1s;">
        <a class="contact-option" href={`mailto:${personalData.email}`}>
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </span>
          <span class="contact-copy">
            <strong>Email</strong>
            <small>{personalData.email}</small>
          </span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>

        <a
          class="contact-option"
          href={`https://www.linkedin.com/in/${personalData.linkedin}/`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-icon brand-icon" aria-hidden="true">
            <iconify-icon icon="simple-icons:linkedin" width="23" height="23" />
          </span>
          <span class="contact-copy">
            <strong>LinkedIn</strong>
            <small>Professional profile</small>
          </span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>

        <a
          class="contact-option"
          href={`https://github.com/${personalData.github}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-icon brand-icon" aria-hidden="true">
            <iconify-icon icon="simple-icons:github" width="24" height="24" />
          </span>
          <span class="contact-copy">
            <strong>GitHub</strong>
            <small>Projects and code</small>
          </span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#contact .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>

<style>
  .contact-intro {
    max-width: 38rem;
    margin: 1.25rem auto 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .contact-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-option {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .contact-option:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--bg-card-hover, var(--bg-card));
  }

  .contact-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .contact-icon {
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 2.75rem;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: 0.625rem;
  }

  .contact-icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .brand-icon {
    color: var(--text);
  }

  .contact-copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
  }

  .contact-copy strong {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .contact-copy small {
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-arrow {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 1rem;
    transition: transform 180ms ease, color 180ms ease;
  }

  .contact-option:hover .contact-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .contact-links {
      grid-template-columns: 1fr;
      max-width: 36rem;
      margin-inline: auto;
    }
  }
</style>
