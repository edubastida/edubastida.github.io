---
import projectsFile from '../data/projects.json';
import '../styles/project-gallery.css';
import { augmentProjectsWithImages, type ProjectEntry } from '../lib/fetchGitHub';
import { withBase } from '../lib/assetPath';

interface Props {
  featuredOnly?: boolean;
}
const { featuredOnly = false } = Astro.props;

const allProjectsData = await augmentProjectsWithImages(projectsFile.items as ProjectEntry[]);
const displayProjects = featuredOnly
  ? allProjectsData.filter((p) => p.sliderImage)
  : allProjectsData;

---

<section id="projects" class="py-24 bg-slate-900/30" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">My work</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Featured Projects</h2>
    </div>

    <div
      id="projects-grid"
      class="mx-auto grid max-w-5xl grid-cols-1 gap-16"
    >
      {
        displayProjects.map((project, i) => (
          <div
            class:list={['project-card reveal', (project.images?.length || project.youtubeId) ? 'has-screens' : '']}
            id={`work-${i}`}
            data-category={project.category}
            data-featured={(project as any).featured ? 'true' : 'false'}
            style={`transition-delay: ${(i % 3) * 0.07}s;`}

          >
            <div class="project-card-inner">

              <div class="p-5 flex flex-col flex-1 relative z-10">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <p class="text-xs font-bold text-highlight uppercase tracking-widest leading-tight">
                    {project.company}
                  </p>
                </div>

                <h3 class="project-title text-lg font-bold mb-2 leading-snug">{project.title}</h3>

                <p class="card-desc text-slate-400 text-sm leading-relaxed flex-1 mb-4">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>

              {((project.images && project.images.length > 0) || project.youtubeId) && (
                <div class="project-screens" data-youtube-id={project.youtubeId}>
                  {project.youtubeId && (
                    <div
                      class="project-video project-media"
                      style={`--video-poster: url("https://i.ytimg.com/vi/${project.youtubeId}/maxresdefault.jpg")`}
                    >
                      <div
                        class="project-video-player"
                        data-video-id={project.youtubeId}
                        data-video-title={`${project.title} trailer`}
                      ></div>
                    </div>
                  )}
                  {project.images.map((src, index) => (
                    <img class="project-shot project-media" src={withBase(src)} alt={`${project.title} — Gameplay ${index + 1}`} hidden={Boolean(project.youtubeId) || index !== 0} loading={index === 0 ? "eager" : "lazy"} width="1280" height="720" />
                  ))}
                  {(project.images.length + (project.youtubeId ? 1 : 0)) > 1 && (
                    <div class="shot-thumbnails" aria-label={`Screenshots for ${project.title}`}>
                      {project.youtubeId && (
                        <button
                          type="button"
                          class="shot-thumbnail shot-thumbnail-video is-active"
                          data-media-kind="video"
                          aria-label={`Play ${project.title} trailer`}
                          aria-current="true"
                        >
                          <img src={`https://i.ytimg.com/vi/${project.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" width="160" height="90" />
                          <span class="thumbnail-play" aria-hidden="true">▶</span>
                        </button>
                      )}
                      {project.images.map((src, index) => (
                        <button
                          type="button"
                          class={`shot-thumbnail ${!project.youtubeId && index === 0 ? 'is-active' : ''}`}
                          data-media-kind="image"
                          data-shot-index={index}
                          aria-label={`Show screenshot ${index + 1}`}
                          aria-current={!project.youtubeId && index === 0 ? 'true' : undefined}
                        >
                          <img src={withBase(src)} alt="" loading="lazy" width="160" height="90" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              )}

              <div class="project-footer relative z-10">
                <div class="footer-shimmer" aria-hidden="true" />
                {(project.links ?? (project.link ? [{ url: project.link, label: project.link.includes('itch.io') ? 'View on itch.io ↗' : 'View on GitHub ↗' }] : [])).map((link) => (
                  <a class="btn-primary itch-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>

  </div>
</section>

<script is:inline>
  // @ts-nocheck

  document.querySelectorAll('#projects .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  const loadYouTubeApi = () => {
    if (window.YT?.Player) return Promise.resolve(window.YT);
    if (window.__portfolioYouTubeApi) return window.__portfolioYouTubeApi;
    window.__portfolioYouTubeApi = new Promise((resolve) => {
      const previousReady = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof previousReady === 'function') previousReady();
        resolve(window.YT);
      };
      const script = document.createElement('script');
      script.src = 'https://www.youtube.com/iframe_api';
      script.async = true;
      document.head.appendChild(script);
    });
    return window.__portfolioYouTubeApi;
  };

  document.querySelectorAll('.project-screens').forEach((gallery) => {
    const shots = [...gallery.querySelectorAll('.project-shot')];
    const videoSlide = gallery.querySelector('.project-video');
    const videoHost = gallery.querySelector('.project-video-player');
    const thumbnails = [...gallery.querySelectorAll('.shot-thumbnail')];
    const videoThumbnail = gallery.querySelector('[data-media-kind="video"]');
    let current = videoSlide ? -1 : 0;
    let timer, player, visible = false, videoFinished = false;

    const stopTimer = () => clearInterval(timer);
    const updateThumbnails = () => {
      thumbnails.forEach((thumbnail) => {
        const active = thumbnail.dataset.mediaKind === 'video'
          ? current === -1
          : Number(thumbnail.dataset.shotIndex) === current && current >= 0;
        thumbnail.classList.toggle('is-active', active);
        if (active) thumbnail.setAttribute('aria-current', 'true');
        else thumbnail.removeAttribute('aria-current');
      });
    };
    const showImage = (index) => {
      if (!shots.length) return;
      if (player?.stopVideo) player.stopVideo();
      if (videoSlide) videoSlide.hidden = true;
      current = (index + shots.length) % shots.length;
      shots.forEach((shot, shotIndex) => { shot.hidden = shotIndex !== current; });
      updateThumbnails();
    };
    const startImages = () => {
      stopTimer();
      if (visible && !document.hidden && current >= 0 && (shots.length > 1 || videoSlide)) {
        timer = setInterval(() => {
          if (videoSlide && current === shots.length - 1) showVideo();
          else showImage(current + 1);
        }, 2500);
      }
    };
    const showVideo = () => {
      if (!videoSlide) return;
      stopTimer();
      current = -1;
      videoFinished = false;
      shots.forEach((shot) => { shot.hidden = true; });
      videoSlide.hidden = false;
      updateThumbnails();
      if (player) {
        player.seekTo(0, true);
        player.mute();
        player.playVideo();
      }
    };

    thumbnails.forEach((button) => {
      button.addEventListener('click', event => {
        event.stopPropagation();
        if (button === videoThumbnail) showVideo();
        else {
          showImage(Number(button.dataset.shotIndex));
          startImages();
        }
      });
    });

    if (videoHost) {
      loadYouTubeApi().then((YT) => {
        player = new YT.Player(videoHost, {
          width: '100%',
          height: '100%',
          videoId: videoHost.dataset.videoId,
          playerVars: {
            autoplay: 0,
            controls: 1,
            mute: 1,
            playsinline: 1,
            rel: 0,
            origin: window.location.origin
          },
          events: {
            onReady: () => {
              const iframe = player.getIframe();
              iframe.title = videoHost.dataset.videoTitle || 'Project trailer';
              iframe.style.width = '100%';
              iframe.style.height = '100%';
              iframe.style.display = 'block';
              player.mute();
              if (visible && current === -1 && !videoFinished) player.playVideo();
            },
            onStateChange: (event) => {
              if (event.data === YT.PlayerState.ENDED) {
                videoFinished = true;
                showImage(0);
                startImages();
              }
            }
          }
        });
      });
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopTimer();
        if (current === -1 && player?.pauseVideo) player.pauseVideo();
      } else if (visible) {
        if (current === -1 && !videoFinished && player?.playVideo) player.playVideo();
        else startImages();
      }
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) {
        stopTimer();
        if (current === -1 && player?.pauseVideo) player.pauseVideo();
      } else if (current === -1 && !videoFinished && player?.playVideo) {
        player.mute();
        player.playVideo();
      } else {
        startImages();
      }
    }, {threshold: .35}).observe(gallery);
  });

</script>

<style is:global>
  .project-card {
    transition: opacity 0.2s ease;
    position: relative;
    cursor: pointer;
  }
  .project-card:focus-visible .project-card-inner {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .project-card.pf-hidden {
    display: none;
  }
  .project-card.pf-enter {
    animation: card-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0s) both;
  }
  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .float-icon-wrap {
    position: absolute;
    top: -14px;
    right: 16px;
    z-index: 20;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--bg-card-solid);
    border: 1px solid var(--border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px;
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .project-card:hover .float-icon-wrap {
    transform: translateY(-4px) scale(1.1);
    border-color: var(--border-hover);
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.35),
      0 0 18px rgba(99, 102, 241, 0.15);
  }
  .float-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .float-icon-mdi {
    filter: invert(1) brightness(0.85);
  }

  .category-badge {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: rgba(99, 102, 241, 0.05);
    border: 1px solid rgba(99, 102, 241, 0.12);
    opacity: 0.7;
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    position: relative;
    z-index: 1;
    white-space: nowrap;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .project-card:hover .category-badge {
    color: var(--text-muted);
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.3);
    opacity: 1;
  }
  .project-card.has-bg .category-badge {
    color: rgba(226, 232, 240, 0.65);
  }

  .card-bg-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .card-bg-img::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(155deg, rgba(4, 8, 22, 0.38) 0%, rgba(4, 8, 22, 0.62) 100%);
    transition: background 0.55s ease;
  }
  .project-card:hover .card-bg-img::after {
    background: linear-gradient(155deg, rgba(4, 8, 22, 0.26) 0%, rgba(4, 8, 22, 0.5) 100%);
  }
  .card-bg-img img {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    filter: blur(24px) saturate(2.1) brightness(0.44) grayscale(0.25);
    transition: filter 0.55s ease;
  }
  .project-card:hover .card-bg-img img {
    filter: blur(18px) saturate(2.5) brightness(0.56) grayscale(0.25);
  }

  .project-card-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
    transition:
      transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  .project-card-inner.has-bg-img {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .project-card:hover .project-card-inner {
    transform: translateY(-5px);
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow:
      0 20px 52px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(99, 102, 241, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .project-title {
    color: var(--text);
    transition: color 0.35s ease;
  }
  .project-card:not(.has-bg):hover .project-title {
    color: var(--accent);
  }
  .project-card.has-bg .project-title {
    color: #e2e8f0;
  }
  .project-card.has-bg:hover .project-title {
    color: var(--accent);
  }

  .project-card.has-bg .card-desc {
    color: rgba(203, 213, 225, 0.82);
  }

  .card-glow {
    display: none;
  }

  .project-footer {
    overflow: hidden;
    border-top: 1px solid var(--border);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: rgba(0, 0, 0, 0.1);
    gap: 0.75rem;
    transition:
      border-top-color 0.35s ease,
      background 0.35s ease;
  }
  .project-card:hover .project-footer {
    border-top-color: rgba(99, 102, 241, 0.22);
    background: rgba(99, 102, 241, 0.06);
  }
  .project-card.has-bg .project-footer {
    background: rgba(0, 0, 0, 0.32);
    border-top-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .project-card.has-bg:hover .project-footer {
    background: rgba(99, 102, 241, 0.22);
    border-top-color: rgba(99, 102, 241, 0.35);
  }
  .footer-shimmer {
    display: none;
  }

  .card-icon {
    color: rgba(99, 102, 241, 0.45);
    transition: color 0.35s ease;
  }
  .project-footer .card-icon svg {
    transition:
      transform 300ms ease,
      opacity 300ms ease;
  }
  .project-card-inner:hover .project-footer .card-icon svg {
    transform: translateY(80px);
    opacity: 0;
  }

  [data-theme='light'] .float-icon-mdi {
    filter: none;
  }

  [data-theme='light'] .project-card.has-bg .card-bg-img::after {
    display: none;
  }
  [data-theme='light'] .project-card.has-bg .card-bg-img {
    filter: invert(0.88) saturate(1.4) brightness(1.1);
  }
  [data-theme='light'] .project-card.has-bg:hover .card-bg-img {
    filter: invert(0.88) saturate(1.7) brightness(1.2);
  }
  [data-theme='light'] .project-card.has-bg .card-bg-img img {
    filter: blur(24px) saturate(1.8) brightness(0.72);
  }
  [data-theme='light'] .project-card.has-bg:hover .card-bg-img img {
    filter: blur(18px) saturate(2.1) brightness(0.82);
  }

  [data-theme='light'] .project-card-inner.has-bg-img {
    background: rgba(255, 255, 255, 0.52);
  }

  [data-theme='light'] .project-card.has-bg .project-card-inner {
    color: #1e293b;
  }
  [data-theme='light'] .project-card.has-bg h3 {
    color: #0f172a;
  }
  [data-theme='light'] .project-card.has-bg p {
    color: rgba(15, 23, 42, 0.75);
  }
  [data-theme='light'] .project-card.has-bg .project-title {
    color: #0f172a;
  }
  [data-theme='light'] .project-card.has-bg:hover .project-title {
    color: var(--accent);
  }
  [data-theme='light'] .project-card.has-bg .card-desc {
    color: rgba(30, 41, 59, 0.78);
  }
  [data-theme='light'] .project-card.has-bg .category-badge {
    color: rgba(15, 23, 42, 0.6);
  }
  [data-theme='light'] .project-card:hover .project-card-inner {
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.1),
      0 0 0 1px rgba(109, 40, 217, 0.18);
  }

  [data-theme='light'] .project-footer {
    background: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(0, 0, 0, 0.07);
    color: var(--text-muted);
  }
  [data-theme='light'] .project-card:hover .project-footer {
    background: rgba(109, 40, 217, 0.05);
  }
  [data-theme='light'] .project-card.has-bg .project-footer {
    background: rgba(255, 255, 255, 0.55);
    border-top-color: rgba(0, 0, 0, 0.08);
  }
  [data-theme='light'] .project-card.has-bg:hover .project-footer {
    background: rgba(109, 40, 217, 0.08);
  }

  [data-theme='light'] .modal-cat-badge {
    color: #ffffff;
    background: #6d28d91f;
    border-color: #f5f5f5d6;
  }
  [data-theme='light'] .modal-heading {
    color: white;
    text-shadow: 1px 1px 5px rgb(0 0 0);
  }
  [data-theme='light'] .modal-company {
    color: #ffffff;
    font-weight: 700;
    opacity: 1;
    text-decoration: underline;
  }
</style>
