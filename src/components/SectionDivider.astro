<div class="sd" aria-hidden="true">
  <div class="sd-pill sd-l"></div>
  <div class="sd-pill sd-r"></div>
</div>

<style>
  .sd {
    position: relative;
    width: 100%;
    height: 24px;
    overflow: hidden;
    margin: 0;
    z-index: 10;
  }

  .sd::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(82%, 1080px);
    height: 1px;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent, var(--border) 18%, var(--border) 82%, transparent);
    opacity: 0.55;
  }

  .sd::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4px;
    height: 4px;
    transform: translate(-50%, -50%) rotate(45deg);
    background: var(--accent);
    opacity: 0.4;
  }

  .sd-pill { display: none; }
</style>

<script>
  document.querySelectorAll('.sd').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.5 }
    );
    io.observe(el);
  });
</script>
